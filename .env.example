# OPENROUTER_API_KEY: Required for vision AI judge (OpenRouter API).
# Get your key at https://openrouter.ai/keys
# The model used is: google/gemini-flash-1.5
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# DJANGO_SECRET_KEY: Django secret key for session signing etc.
DJANGO_SECRET_KEY="django-insecure-replace-this-in-production"

# DJANGO_DEBUG: Set to "False" in production.
DJANGO_DEBUG="True"

# DATABASE_URL: PostgreSQL connection string (uses SQLite if not set).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=""

# APP_URL: The URL where the backend is hosted.
APP_URL="http://localhost:8000"
